{
  "name": "repo-mover",
  "version": "1.0.0",
  "description": "Bitbucket to GitHub migration tool",
  "author": "chadleyclark@gmail.com",
  "repository": "https://github.com/ChadleyC/repo-mover",
  "homepage": "https://github.com/ChadleyC/repo-mover#readme",
  "bugs": "https://github.com/ChadleyC/repo-mover/issues",
  "keywords": [
    "bitbucket",
    "github",
    "migration",
    "git",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "bin": {
    "repo-mover": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run lint",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bitbucket": "^2.10.1",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "inquirer": "^13.4.1",
    "octokit": "^3.1.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
